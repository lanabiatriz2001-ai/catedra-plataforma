<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Processo e peças</title>
<style>
:root{
  /* Padrão CLARO, no tom do Cátedra; a ponte abaixo troca tudo pelos tokens do app
     (acento, superfícies, fontes), então a página fica com a cara do tema que a pessoa
     escolheu — antes era um azul-escuro fixo, estranho dentro de um app claro. */
  --bg:#faf7f5;--surface:#ffffff;--surface2:#f3eeea;--border:#e2d9d3;
  --ink:#1b1b1f;--text2:#4b4a52;--text3:#7d7a86;
  --accent:#b5174e;--accentD:#8e0f3c;--onAccent:#ffffff;
  --lei:#9a6b00;--juris:#b93a2b;--peca:#5b47b8;--desvio:#1f6f8b;--assunto:#1f5aa6;
  --display:Georgia,serif;--body:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;--mono:ui-monospace,Menlo,monospace;
}
*{box-sizing:border-box}
/* Não prender em height:100%: num visualizador que não dá altura ao documento isso
   colapsa e a tela fica preta. O palco tem altura PRÓPRIA em px, com teto no viewport. */
html,body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--body)}
/* Painel do roteiro de peça: entra pela direita, por cima do mapa. */
.rot{position:fixed;top:0;right:0;bottom:0;width:min(560px,94vw);background:var(--surface);
  border-left:1px solid var(--border);z-index:40;transform:translateX(102%);transition:transform .22s ease;
  display:flex;flex-direction:column}
.rot.on{transform:none}
.rotTop{display:flex;align-items:flex-start;gap:12px;padding:16px 18px;border-bottom:1px solid var(--border)}
.rotTop h2{margin:0;font:800 19px var(--display);line-height:1.2}
.rotTop p{margin:4px 0 0;font-size:12px;color:var(--text3)}
.rotX{margin-left:auto;flex:none;border:1px solid var(--border);background:var(--surface2);color:var(--text2);
  border-radius:9px;width:32px;height:32px;font-size:16px;cursor:pointer}
.rotSc{flex:1;overflow:auto;padding:14px 18px 40px}
.rotTabs{display:flex;gap:7px;padding:0 18px 12px}
.rotTabs button{border:1px solid var(--border);background:var(--surface2);color:var(--text2);
  border-radius:99px;padding:6px 14px;font:700 12px inherit;cursor:pointer}
.rotTabs button.on{background:var(--accent);border-color:var(--accent);color:#fff}
.blk{border:1px solid var(--border);background:var(--surface2);border-radius:13px;padding:14px 16px;margin-bottom:11px;
  border-left:4px solid var(--peca)}
.blk h3{margin:0 0 7px;font:800 14px inherit;display:flex;align-items:center;gap:9px}
.blk h3 i{font-style:normal;width:22px;height:22px;border-radius:7px;background:var(--peca);color:#15121f;
  display:flex;align-items:center;justify-content:center;font:800 11px var(--mono);flex:none}
.blk .deve{font-size:13.5px;line-height:1.6;color:var(--ink)}
.blk .rf{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
.blk .rf button{border:1px solid var(--border);background:var(--bg);border-radius:8px;padding:5px 10px;
  font:600 11.5px inherit;cursor:pointer;text-align:left}
.blk .rf button.lei{color:var(--lei);border-color:color-mix(in srgb,var(--lei) 45%,transparent)}
.blk .rf button.juris{color:var(--juris);border-color:color-mix(in srgb,var(--juris) 45%,transparent)}
.blk .erro{margin-top:10px;font-size:12.5px;line-height:1.55;color:var(--ink);
  background:color-mix(in srgb,var(--juris) 10%,var(--surface));border-left:3px solid var(--juris);padding:9px 11px;border-radius:0 8px 8px 0}
.blk .erro b{color:var(--juris)}
.cego li{margin-bottom:9px;font-size:13.5px;line-height:1.5}
.cego label{display:flex;gap:10px;align-items:flex-start;cursor:pointer}
.cego input{margin-top:3px;flex:none;width:16px;height:16px;accent-color:var(--accent)}
.rotNota{font-size:11.5px;color:var(--text3);line-height:1.55;margin-top:16px;border-top:1px solid var(--border);padding-top:12px}
.barra{position:sticky;top:0;z-index:10;padding:10px 14px;
  background:color-mix(in srgb,var(--surface) 92%,transparent);backdrop-filter:blur(8px);border-bottom:1px solid var(--border);
  display:flex;align-items:center;gap:10px}
/* Os 14 ritos rolam de LADO numa faixa só. Deixando quebrar linha, em tela estreita
   (iPad em retrato) eles viravam uma coluna de 14 e empurravam o mapa para fora. */
#mats{display:flex;gap:6px;overflow-x:auto;flex:1;padding-bottom:2px;scrollbar-width:thin}
#mats .pill{flex:none;white-space:nowrap}
.ferr{flex:none}
.h1{font-family:var(--display);font-size:18px;font-weight:700;margin-right:6px}
/* Abas do módulo: Trâmite (o mapa) · Roteiros de peças · Banco de peças e discursivas */
/* Linguagem BRUTALISTA (igual à Redação): cantos retos, borda grossa de tinta,
   sombra dura deslocada — nada de blur, nada de raio suave. */
.abas{display:flex;gap:4px;background:var(--surface2);border:3px solid var(--ink);border-radius:0;padding:4px;margin-right:10px}
.abas button{border:0;background:transparent;color:var(--text2);border-radius:0;padding:7px 15px;font:800 12px inherit;text-transform:uppercase;letter-spacing:.04em;cursor:pointer}
.abas button.on{background:var(--accent);color:var(--onAccent,#04140d)}
.painel{display:none;padding:18px 16px 40px;max-width:1300px;margin:0 auto}
.painel.on{display:block}
.rlist{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px}
#rlist{display:block}
.rcard{border:3px solid var(--ink);background:var(--surface2);border-radius:0;padding:16px 18px;cursor:pointer;text-align:left;font-family:inherit;color:var(--ink);box-shadow:6px 6px 0 var(--border);transition:transform .08s}
.rcard b{display:block;font-size:14.5px;font-weight:800;margin-bottom:5px}
.rcard span{font-size:11.5px;color:var(--text3);font-weight:600;text-transform:uppercase;letter-spacing:.03em}
.rcard.falta{opacity:.5;box-shadow:none;cursor:default}
.bfil{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px}
.bfil select,.bfil input{border:3px solid var(--ink);background:var(--surface2);color:var(--ink);border-radius:0;padding:9px 12px;font:13px inherit}
.bfil input{flex:1;min-width:200px}
.qcard{border:3px solid var(--ink);background:var(--surface2);border-radius:0;padding:15px 17px;margin-bottom:12px;box-shadow:6px 6px 0 var(--border)}
.qcard .meta{display:flex;gap:7px;flex-wrap:wrap;align-items:center;margin-bottom:7px}
.qcard .meta i{font-style:normal;font:800 10.5px var(--mono);color:var(--ink)}
.qcard .meta em{font-style:normal;font:800 10px inherit;letter-spacing:.05em;text-transform:uppercase;border-radius:0;border:2px solid var(--ink);padding:2px 9px;background:var(--peca);color:#15121f}
.qcard .meta em.disc{background:var(--assunto);color:#fff}
.qcard .meta em.esp{background:transparent;color:var(--ink)}
.qcard b{display:block;font-size:14px;font-weight:800;margin-bottom:4px}
.qcard p{margin:0;font-size:12.5px;color:var(--text2);line-height:1.55}
.qcard button{margin-top:10px;border:3px solid var(--ink);background:var(--accent);color:var(--onAccent,#04140d);border-radius:0;padding:7px 14px;font:800 12px inherit;text-transform:uppercase;letter-spacing:.03em;cursor:pointer;box-shadow:3px 3px 0 var(--border)}
.pill{border:1px solid var(--border);background:var(--surface2);color:var(--text2);
  border-radius:99px;padding:6px 13px;font-size:12.5px;font-weight:600;cursor:pointer;font-family:inherit}
.pill.on{background:var(--accent);border-color:var(--accent);color:var(--onAccent,#fff)}
.ferr{margin-left:auto;display:flex;gap:6px;align-items:center}
.ferr button{width:32px;height:30px;border:1px solid var(--border);background:var(--surface2);
  color:var(--text2);border-radius:8px;cursor:pointer;font-size:14px}
.zoomlbl{font-family:var(--mono);font-size:11px;color:var(--text3);min-width:42px;text-align:center}

#palco{position:relative;width:100%;height:78vh;min-height:480px;
  overflow:hidden;touch-action:none;cursor:grab;background:var(--bg)}
#palco.arrastando{cursor:grabbing}
#mundo{position:absolute;left:0;top:0;transform-origin:0 0}
svg#fios{position:absolute;left:0;top:0;overflow:visible;pointer-events:none}

.no{position:absolute;transform:translate(-50%,-50%);border-radius:11px;padding:8px 12px;
  font-size:13px;font-weight:600;border:1px solid var(--border);background:var(--surface2);
  cursor:pointer;white-space:nowrap;user-select:none}
.no small{display:block;font-weight:400;font-size:10px;color:var(--text3)}
.no .cnt{display:inline-block;margin-left:7px;font-family:var(--mono);font-size:10px;
  color:var(--text3);border:1px solid var(--border);border-radius:99px;padding:0 5px}
.raiz{background:var(--accent);border-color:var(--accent);color:var(--onAccent,#fff);
  font-family:var(--display);font-size:15px;padding:12px 16px}
.materia{background:color-mix(in srgb,var(--assunto) 14%,var(--surface));border-color:var(--assunto);color:var(--ink);font-size:14px}
.assunto{background:var(--surface2);border-color:var(--border);font-family:var(--display);font-size:14px}
.fase{background:var(--surface2);border-color:var(--border)}
.lei{border-color:var(--lei);color:var(--lei);background:color-mix(in srgb,var(--lei) 10%,var(--surface));font-size:12px}
.juris{border-color:var(--juris);color:var(--juris);background:color-mix(in srgb,var(--juris) 10%,var(--surface));font-size:12px}
.peca{border-color:var(--peca);color:var(--peca);background:color-mix(in srgb,var(--peca) 10%,var(--surface));font-size:12px}
.desvio{border-color:var(--desvio);color:var(--desvio);background:color-mix(in srgb,var(--desvio) 10%,var(--surface));
  font-size:11.5px;border-style:dashed}
.fechado{opacity:.92}
.legenda{position:sticky;bottom:0;z-index:10;padding:7px 14px;
  background:color-mix(in srgb,var(--surface) 92%,transparent);border-top:1px solid var(--border);
  display:flex;gap:14px;flex-wrap:wrap;font-size:11px;color:var(--text3)}
.legenda span{display:inline-flex;align-items:center;gap:5px}
.dot{width:8px;height:8px;border-radius:2px;display:inline-block}

/* ---- Linha do tempo do rito: o trâmite como SEQUÊNCIA didática, não como mapa ---- */
#linha{display:none;padding:18px 16px 48px;max-width:1100px;margin:0 auto}
#linha.on{display:block}
.lt-head{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;margin:4px 0 18px}
.lt-head h2{margin:0;font:800 24px var(--display);letter-spacing:-.3px}
.lt-head small{color:var(--text3);font-size:12.5px}
.lt{position:relative;padding-left:46px}
.lt::before{content:"";position:absolute;left:17px;top:8px;bottom:8px;width:3px;background:var(--border)}
.ato{position:relative;margin-bottom:14px;border:3px solid var(--ink);background:var(--surface);padding:14px 16px 12px;box-shadow:6px 6px 0 var(--border)}
.ato .num{position:absolute;left:-46px;top:10px;width:36px;height:36px;border:3px solid var(--ink);background:var(--accent);color:var(--onAccent,#fff);
  display:flex;align-items:center;justify-content:center;font:800 13px var(--mono)}
.ato h3{margin:0;font:800 16px var(--display)}
.ato .quando{margin:2px 0 0;font-size:12px;color:var(--text3);font-weight:600;text-transform:uppercase;letter-spacing:.04em}
.ato .grupos{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px;margin-top:12px}
.ato .g{border:1px solid var(--border);background:var(--surface2);padding:9px 11px}
.ato .g b{display:block;font:800 10.5px var(--mono);text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px}
.ato .g.lei b{color:var(--lei)}.ato .g.juris b{color:var(--juris)}.ato .g.peca b{color:var(--peca)}.ato .g.desvio b{color:var(--desvio)}
.ato .g button{display:block;width:100%;text-align:left;border:0;background:transparent;color:var(--ink);padding:3px 0;font:600 12.5px var(--body);cursor:pointer;line-height:1.35}
.ato .g button:hover{color:var(--accent);text-decoration:underline}
.ato .g.desvio button{cursor:default;color:var(--text2)}
.ato .g.desvio button:hover{color:var(--text2);text-decoration:none}
.lt-vazio{color:var(--text3);font-size:13px;padding:20px}
/* Roteiros: escritos em destaque; os demais, lista discreta */
.rsec{font:800 11px var(--mono);text-transform:uppercase;letter-spacing:.06em;color:var(--text3);margin:16px 0 10px}
.rcard .prev{display:block;margin-top:8px;font-size:12px;color:var(--text2);line-height:1.5;text-transform:none;letter-spacing:0;font-weight:500}
.rpend{display:flex;flex-wrap:wrap;gap:6px}
.rpend span{border:1px solid var(--border);background:var(--surface2);color:var(--text3);padding:4px 10px;font-size:12px;border-radius:99px}
</style><script>(function(){var V=['--bg','--surface','--surface2','--border','--ink','--text2','--text3','--accent','--accentD','--accentSoft','--accentRing','--onAccent','--radius','--display','--body','--mono','--heroGrad'];function apply(t){var r=document.documentElement;V.forEach(function(v){if(t[v]&&t[v].trim())r.style.setProperty(v,t[v].trim());});}try{var pw=window.parent;if(pw&&pw!==window){var host=pw.document.querySelector('[style*="--accent"]');if(host){var cs=pw.getComputedStyle(host);var t={};V.forEach(function(v){t[v]=cs.getPropertyValue(v);});apply(t);}}}catch(e){}window.addEventListener('message',function(e){if(e.data&&e.data.type==='ctTheme'&&e.data.tokens)apply(e.data.tokens);});})();</script></head><body>

<div class="barra">
  <span class="h1">Processo e peças</span>
  <span class="abas" id="abas"><button data-p="linha" class="on">Trâmite</button><button data-p="mapa">Mapa</button><button data-p="roteiros">Roteiros de peças</button><button data-p="banco">Peças e discursivas</button></span>
  <span id="mats"></span>
  <span class="ferr">
    <button id="menos">−</button><span class="zoomlbl" id="zl">100%</span><button id="mais">+</button>
    <button id="ajusta" title="Enquadrar">⤢</button>
    <button id="tudo" title="Abrir tudo">⊕</button>
  </span>
</div>

<div id="linha"></div>
<div id="palco"><div id="mundo"><svg id="fios"></svg></div></div>

<div class="legenda">
  <span><i class="dot" style="background:var(--assunto)"></i> matéria</span>
  <span><i class="dot" style="background:#41627a"></i> fase do trâmite</span>
  <span><i class="dot" style="background:var(--lei)"></i> dispositivo → CátedraLEGIS</span>
  <span><i class="dot" style="background:var(--juris)"></i> jurisprudência → CátedraJURIS</span>
  <span><i class="dot" style="background:var(--peca)"></i> peça</span>
  <span><i class="dot" style="background:var(--desvio)"></i> desvio do fluxo</span>
  <span style="margin-left:auto">toque num nó para abrir/fechar · pinça ou roda para ampliar</span>
</div>

<div class="painel" id="pRoteiros">
  <p style="font-size:12.5px;color:var(--text3);margin:0 0 12px">O esqueleto de cada peça: blocos na ordem, o dispositivo que manda, a jurisprudência e o erro que custa ponto. Também abre clicando num ato ✍️ do trâmite.</p>
  <div class="rlist" id="rlist"></div>
</div>
<div class="painel" id="pBanco">
  <p style="font-size:12.5px;color:var(--text3);margin:0 0 12px">Peças e questões discursivas de provas aplicadas, com o espelho oficial quando a banca publicou. "Praticar" leva a questão para a Redação, com o espelho no lugar.</p>
  <div class="bfil"><input id="bq" placeholder="Buscar por tema, órgão, banca, ano…"><select id="btipo"><option value="">Peças e discursivas</option><option value="peca">Só peças</option><option value="discursiva">Só discursivas</option></select><select id="bcarr"><option value="">Todas as carreiras</option></select><select id="bdisc"><option value="">Todas as disciplinas</option></select></div>
  <div id="blist"></div>
</div>
<div class="rot" id="rot">
  <div class="rotTop"><div><h2 id="rotTit"></h2><p id="rotSub"></p></div><button class="rotX" id="rotX">✕</button></div>
  <div class="rotTabs"><button id="rotTabR" class="on">Roteiro</button><button id="rotTabC">Modo cego</button></div>
  <div class="rotSc" id="rotSc"></div>
</div>

<script src="ritos.js"></script>
<script src="pecas.js"></script>
<script src="discursivas.js"></script>
<script>
/* ===== ROTEIRO DE PEÇA =====================================================
   O mapa dá a SEQUÊNCIA; aqui vem o esqueleto da peça. Dois modos: "Roteiro"
   (blocos com o que deve constar, o dispositivo, a jurisprudência e o erro que
   custa ponto) e "Modo cego" (só a checklist, para escrever sem consultar e
   conferir depois). O que está marcado no modo cego fica gravado por peça.
   --------------------------------------------------------------------------- */
(function(){
  const rot=document.getElementById('rot'), sc=document.getElementById('rotSc');
  const tabR=document.getElementById('rotTabR'), tabC=document.getElementById('rotTabC');
  let atual=null, modo='roteiro';
  const CK='catedraPecasCego';                 // sem prefixo catedra: — não sobe para a nuvem
  const lerCk=()=>{ try{ return JSON.parse(localStorage.getItem(CK))||{}; }catch(e){ return {}; } };
  const gravaCk=(o)=>{ try{ localStorage.setItem(CK,JSON.stringify(o)); }catch(e){} };
  const esc=(t)=>String(t==null?'':t).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

  // O rótulo é escrito para LER ("Elementos essenciais da sentença — CPC, art. 489, I").
  // Para BUSCAR, isso não serve: o catálogo do LEGIS procura pelo nome do diploma, e o
  // acervo do JURIS pelo instituto. Então o termo é recortado do rótulo.
  const SIGLA={CPC:'Código de Processo Civil', CPP:'Código de Processo Penal',
    CP:'Código Penal', CC:'Código Civil', CF:'Constituição', CDC:'Código de Defesa do Consumidor',
    CLT:'Consolidação das Leis do Trabalho', CTN:'Código Tributário Nacional'};
  function termoBusca(rotulo, alvo){
    const partes=String(rotulo).split('—');
    if(alvo==='juris') return partes[0].trim();          // o instituto, não o artigo
    const ref=(partes[1]||partes[0]).trim();             // "CPC, art. 489, I"
    const m=/^([A-ZÇ]{2,4})\b/.exec(ref);
    if(m&&SIGLA[m[1]]) return SIGLA[m[1]];
    const lei=/Lei\s+[\d.]+\/\d{2,4}/i.exec(ref);       // "Lei 9.099/95"
    return lei?lei[0]:ref;
  }

  function pinta(){
    if(!atual) return;
    const p=(window.CT_PECAS||{})[atual];
    if(!p){ sc.innerHTML='<div style="color:var(--text3);font-size:13px;line-height:1.6">'
      +'O roteiro desta peça ainda não foi escrito. As que já existem: '
      +Object.keys(window.CT_PECAS||{}).map(k=>esc(k)).join(' · ')+'.</div>'; return; }
    if(modo==='cego'){
      const marc=lerCk()[atual]||{};
      sc.innerHTML='<ul class="cego" style="list-style:none;padding:0;margin:0">'
        +(p.cego||[]).map((t,i)=>'<li><label><input type="checkbox" data-i="'+i+'"'
          +(marc[i]?' checked':'')+'><span>'+esc(t)+'</span></label></li>').join('')
        +'</ul><div class="rotNota">Escreva a peça sem olhar o roteiro e depois confira aqui. '
        +'O que você marcar fica guardado neste aparelho.</div>';
      sc.querySelectorAll('input[type=checkbox]').forEach(cx=>{
        cx.onchange=()=>{ const o=lerCk(); o[atual]=o[atual]||{}; o[atual][cx.dataset.i]=cx.checked; gravaCk(o); };
      });
      return;
    }
    sc.innerHTML=(p.blocos||[]).map((b,i)=>{
      const refs=[]
        .concat((b.lei||[]).map(t=>'<button class="lei" data-alvo="legis" data-t="'+esc(t)+'">⚖️ '+esc(t)+'</button>'))
        .concat((b.juris||[]).map(t=>'<button class="juris" data-alvo="juris" data-t="'+esc(t)+'">🏛️ '+esc(t)+'</button>'))
        .join('');
      return '<div class="blk"><h3><i>'+(i+1)+'</i>'+esc(b.nome)+'</h3>'
        +'<div class="deve">'+esc(b.deve)+'</div>'
        +(refs?'<div class="rf">'+refs+'</div>':'')
        +(b.erro?'<div class="erro"><b>Custa ponto:</b> '+esc(b.erro)+'</div>':'')
        +'</div>';
    }).join('')
      +'<div class="rotNota">Os artigos estão aqui porque num roteiro de peça o número é o conteúdo — '
      +'mas clique neles: o texto integral abre no CátedraLEGIS, e é lá que se confere. '
      +'Roteiro escrito pelo Cátedra a partir da lei e da jurisprudência, não copiado de curso.</div>';
    sc.querySelectorAll('.rf button').forEach(b=>{
      b.onclick=()=>{ try{ window.parent.postMessage(
        {type:'ctAbrirAcervo', alvo:b.dataset.alvo, termo:termoBusca(b.dataset.t, b.dataset.alvo)}, '*'); }catch(e){} };
    });
  }

  // ---- Abas do módulo. O mapa fica sempre montado (é caro); só se esconde.
  const palco=document.getElementById('palco'), legenda=document.querySelector('.legenda');
  function abaAtiva(qual){
    document.querySelectorAll('#abas button').forEach(b=>b.classList.toggle('on',b.dataset.p===qual));
    const mapa=(qual==='mapa'), linha=(qual==='linha');
    if(palco)palco.style.display=mapa?'':'none';
    if(legenda)legenda.style.display=(mapa||linha)?'':'none';
    document.getElementById('mats').style.display=(mapa||linha)?'':'none';
    document.querySelector('.ferr').style.display=mapa?'':'none';
    document.getElementById('linha').classList.toggle('on',linha);
    document.getElementById('pRoteiros').classList.toggle('on',qual==='roteiros');
    document.getElementById('pBanco').classList.toggle('on',qual==='banco');
    if(linha)pintaLinha();
    if(mapa){ desenhar(); enquadrar(); }
    if(qual==='roteiros')pintaRoteiros();
    if(qual==='banco')pintaBanco();
    abaAtual=qual;
  }
  let abaAtual='linha';

  // ---- Linha do tempo: o rito escolhido como sequência numerada de atos, cada um com
  // o que manda (⚖️ → LEGIS), o que o tribunal decidiu (🏛️ → JURIS), a peça cabível
  // (✍️ → roteiro) e para onde o processo pode desviar (↘). Lê-se de cima para baixo,
  // como se estuda; o mapa fica como vista alternativa.
  function pintaLinha(){
    const host=document.getElementById('linha'); if(!host)return;
    const rito=(window.CT_RITOS||{})[materia]||[];
    const rot=(t)=>String(t).replace(/^[^\p{L}]+/u,'').trim();
    const grupo=(itens,tipo,titulo)=>{
      const l=itens.filter(f=>f[1]===tipo); if(!l.length)return '';
      return '<div class="g '+tipo+'"><b>'+titulo+'</b>'+l.map(f=>'<button data-k="'+tipo+'" data-t="'+esc(rot(f[0]))+'">'+esc(rot(f[0]))+'</button>').join('')+'</div>';
    };
    host.innerHTML='<div class="lt-head"><h2>'+esc(materia)+'</h2><small>'+rito.length+' atos, na ordem em que acontecem · clique num item para abrir no acervo</small></div>'
      +(rito.length?'<div class="lt">'+rito.map((ato,i)=>{
        const [nome,quando,ramos]=ato; const it=ramos||[];
        return '<div class="ato"><div class="num">'+String(i+1).padStart(2,'0')+'</div><h3>'+esc(nome)+'</h3>'
          +(quando?'<p class="quando">'+esc(quando)+'</p>':'')
          +'<div class="grupos">'+grupo(it,'lei','⚖️ O que manda')+grupo(it,'juris','🏛️ O que o tribunal decidiu')+grupo(it,'peca','✍️ Peça cabível')+grupo(it,'desvio','↘ Desvios possíveis')+'</div></div>';
      }).join('')+'</div>':'<div class="lt-vazio">Este rito ainda não tem atos cadastrados.</div>');
    host.querySelectorAll('.g button').forEach(b=>b.onclick=()=>{
      const k=b.dataset.k, t=b.dataset.t;
      if(k==='peca'){ window.abrirRoteiro(t); return; }
      if(k==='lei'||k==='juris'){ try{ window.parent.postMessage({type:'ctAbrirAcervo', alvo:(k==='lei'?'legis':'juris'), termo:t}, '*'); }catch(_){} }
    });
  }
  document.querySelectorAll('#abas button').forEach(b=>b.onclick=()=>abaAtiva(b.dataset.p));
  // ?aba=roteiros|banco: a mesma página serve a entrada própria do menu "Roteiros e peças"
  // (abre direto nos roteiros de sentença/peças/discursivas, sem passar pelo mapa).
  // A escolha da aba inicial vai para o FIM do script (depois de iniciar()): abaAtiva
  // chama pintaLinha, que usa `materia` — declarado mais abaixo. Chamar aqui estourava
  // "Cannot access 'materia' before initialization" e a página abria vazia.
  window.__abaInicial = () => {
    try{ const _a=new URLSearchParams(location.search).get('aba'); abaAtiva((_a==='roteiros'||_a==='banco'||_a==='mapa')?_a:'linha'); }
    catch(_){ abaAtiva('linha'); }
  };

  // ---- Roteiros: todas as peças que aparecem no trâmite (ritos.js), marcando quais
  // já têm roteiro escrito (pecas.js) e quais ainda não.
  function pecasDoTramite(){
    const nomes=new Set();
    Object.values(window.CT_RITOS||{}).forEach(rito=>rito.forEach(ato=>(ato[2]||[]).forEach(f=>{
      if(f[1]==='peca')nomes.add(String(f[0]).replace(/^[^\p{L}]+/u,'').trim());
    })));
    return [...nomes];
  }
  function pintaRoteiros(){
    const host=document.getElementById('rlist'); if(!host)return;
    const tem=window.CT_PECAS||{};
    const nomes=pecasDoTramite().sort((a,b)=>(b in tem)-(a in tem)||a.localeCompare(b,'pt'));
    const prontos=nomes.filter(n=>tem[n]), pend=nomes.filter(n=>!tem[n]);
    // Os roteiros ESCRITOS são o conteúdo: card com os blocos, na ordem, para a pessoa
    // ver o esqueleto antes de abrir. Os pendentes não viram 21 caixas vazias — são uma
    // lista discreta de "em preparação", que encolhe conforme eu escrevo.
    host.innerHTML=(prontos.length?'<div class="rsec">Roteiros prontos · '+prontos.length+'</div><div class="rlist">'+prontos.map(n=>{
        const p=tem[n]; const bl=(p.blocos||[]).map(b=>b.nome||b).filter(Boolean);
        return '<button class="rcard" data-n="'+esc(n)+'"><b>'+esc(n)+'</b><span>'+bl.length+' blocos · modo cego com '+(p.cego||[]).length+' itens</span>'
          +'<span class="prev">'+bl.map((x,i)=>(i+1)+'. '+esc(x)).join(' · ')+'</span></button>';
      }).join('')+'</div>':'')
      +(pend.length?'<div class="rsec">Em preparação · '+pend.length+'</div><div class="rpend">'+pend.map(n=>'<span>'+esc(n)+'</span>').join('')+'</div>':'');
    host.querySelectorAll('.rcard').forEach(b=>b.onclick=()=>window.abrirRoteiro(b.dataset.n));
  }

  // ---- Banco de peças e discursivas (o MESMO discursivas.js da Redação)
  function pintaBanco(){
    const host=document.getElementById('blist'); if(!host)return;
    const todas=window.CT_DISCURSIVAS||[];
    const sc=document.getElementById('bcarr'), sd=document.getElementById('bdisc');
    if(sc.options.length===1)[...new Set(todas.map(q=>q.carreira).filter(Boolean))].sort().forEach(c=>{const o=document.createElement('option');o.value=c;o.textContent=c;sc.appendChild(o);});
    if(sd.options.length===1)[...new Set(todas.map(q=>q.disciplina).filter(Boolean))].sort().forEach(c=>{const o=document.createElement('option');o.value=c;o.textContent=c;sd.appendChild(o);});
    const q=(document.getElementById('bq').value||'').trim().toLowerCase();
    const tipo=document.getElementById('btipo').value, carr=sc.value, disc=sd.value;
    const lista=todas.filter(x=>{
      if(tipo&&(x.tipo||'discursiva')!==tipo)return false;
      if(carr&&x.carreira!==carr)return false;
      if(disc&&x.disciplina!==disc)return false;
      if(!q)return true;
      return ((x.tema||'')+' '+(x.enunciado||'')+' '+(x.orgao||'')+' '+(x.banca||'')+' '+(x.ano||'')).toLowerCase().includes(q);
    });
    host.innerHTML=(lista.length?'':'<p style="color:var(--text3);font-size:12.5px">Nada com esses filtros.</p>')
      +lista.map(x=>{
        const ehP=x.tipo==='peca';
        const esp=(x.espelho&&x.espelho.length)?(x.espelho.length+' quesitos'+(x.total!=null?' · '+x.total+' pts':'')):'sem espelho publicado';
        return '<div class="qcard"><div class="meta"><i>'+esc([x.orgao,x.ano,x.banca].filter(Boolean).join(' · '))+'</i>'
          +'<em class="'+(ehP?'':'disc')+'">'+esc(ehP?(x.peca||'Peça'):'Discursiva')+'</em><em class="esp">'+esc(esp)+'</em>'
          +(x.carreira?'<em class="esp">'+esc(x.carreira)+'</em>':'')+'</div>'
          +'<b>'+esc(x.tema||x.disciplina||'')+'</b><p>'+esc(String(x.enunciado||'').slice(0,220))+(String(x.enunciado||'').length>220?'…':'')+'</p>'
          +'<button data-id="'+esc(x.id)+'">Praticar na Redação →</button></div>';
      }).join('');
    host.querySelectorAll('.qcard button').forEach(b=>b.onclick=()=>{
      try{ window.parent.postMessage({type:'ctPraticarDiscursiva', id:b.dataset.id}, '*'); }catch(e){}
    });
  }
  ['bq','btipo','bcarr','bdisc'].forEach(id=>{ const el=document.getElementById(id); if(el){ el.oninput=pintaBanco; el.onchange=pintaBanco; } });

  window.abrirRoteiro=function(nome){
    atual=nome; modo='roteiro';
    const p=(window.CT_PECAS||{})[nome];
    document.getElementById('rotTit').textContent=nome;
    document.getElementById('rotSub').textContent=p?(p.sobre||''):'Roteiro ainda não escrito.';
    tabR.classList.add('on'); tabC.classList.remove('on');
    pinta(); rot.classList.add('on');
  };
  document.getElementById('rotX').onclick=()=>rot.classList.remove('on');
  tabR.onclick=()=>{ modo='roteiro'; tabR.classList.add('on'); tabC.classList.remove('on'); pinta(); };
  tabC.onclick=()=>{ modo='cego'; tabC.classList.add('on'); tabR.classList.remove('on'); pinta(); };
  document.addEventListener('keydown',e=>{ if(e.key==='Escape')rot.classList.remove('on'); });
})();
/* ---------------------------------------------------------------------------
   O mapa é uma ÁRVORE, não coordenadas à mão. Layout calculado (tidy tree
   horizontal): dá para adensar à vontade sem reposicionar nada — foi o pedido
   ("muito mais denso"). Cada nó: {t:título, k:tipo, s:subtítulo, f:[filhos]}
   --------------------------------------------------------------------------- */
/* Só a SEQUÊNCIA dos procedimentos. O conteúdo programático não entra aqui — ele já vive
   no edital, e repetir seria duas verdades para a mesma coisa.
   Cada rito é uma sequência de atos, na ordem; de cada ato saem os ramos. */
function montarMapa(){
  const R = window.CT_RITOS||{}, out={};
  Object.keys(R).forEach(nome=>{
    out[nome] = {t:nome, k:'materia', f: R[nome].map(([ato, quando, ramos])=>({
      t: ato, k:'fase', s: quando||'',
      f: (ramos||[]).map(([rot, tipo])=>({t:rot, k:tipo}))
    }))};
  });
  return out;
}
const MAPA = montarMapa();

/* ---------- layout: tidy tree horizontal ---------- */
const LARG = {materia:230, assunto:250, fase:210, sub:240, lei:180, juris:180, peca:180, desvio:180};
// GAPY é a altura RESERVADA por nó. Precisa ser maior que o nó desenhado (~44px com
// subtítulo) senão os irmãos se sobrepõem — foi o que aconteceu na primeira versão.
const GAPX = 78, GAPY = 66;
let materia=Object.keys(MAPA)[0], nos=[], arestas=[], fechados=new Set();

function medir(no, prof){
  no._prof=prof;
  const temFilhos=(no.f||[]).length>0;
  const aberto = temFilhos && !fechados.has(no._id);
  if(!aberto){ no._alt=GAPY; return no._alt; }
  let soma=0; no.f.forEach(f=>{ soma += medir(f, prof+1); });
  no._alt=Math.max(GAPY, soma); return no._alt;
}
function posicionar(no, x, y){
  no._x=x; no._y=y+no._alt/2;
  nos.push(no);
  const aberto=(no.f||[]).length>0 && !fechados.has(no._id);
  if(!aberto) return;
  let cy=y;
  no.f.forEach(f=>{ arestas.push([no,f]); posicionar(f, x+LARG[no.k||'fase']+GAPX, cy); cy+=f._alt; });
}
let seq=0;
function idear(no){ no._id='n'+(seq++); (no.f||[]).forEach(idear); }

const mundo=document.getElementById('mundo'), fios=document.getElementById('fios');
const COR={materia:'#4a8fd4',assunto:'#7fd4b5',fase:'#41627a',sub:'#5f7b8f',lei:'#c9a227',juris:'#e0685c',peca:'#9b86e8',desvio:'#5aa9c9'};

function desenhar(){
  nos=[]; arestas=[];
  const raiz=MAPA[materia];
  medir(raiz,0); posicionar(raiz, 120, 40);
  mundo.querySelectorAll('.no').forEach(e=>e.remove());
  let maxX=0,maxY=0;
  nos.forEach(n=>{
    const d=document.createElement('div');
    const temF=(n.f||[]).length>0, fech=fechados.has(n._id);
    d.className='no '+(n.k||'fase')+(fech?' fechado':'');
    d.style.left=n._x+'px'; d.style.top=n._y+'px';
    d.innerHTML=n.t+(n.s?'<small>'+n.s+'</small>':'')
      +(temF&&fech?'<span class="cnt">+'+n.f.length+'</span>':'');
    d.onclick=(ev)=>{ ev.stopPropagation();
      // ⚖️ e 🏛️ são folhas: em vez de abrir/fechar, pedem ao app para abrir o acervo.
      // O rótulo vira o termo de busca — sem os emojis e sem a seta do desvio.
      // ✍️ é folha também: abre o ROTEIRO da peça no painel lateral.
      if(n.k==='peca'){
        const nome=String(n.t).replace(/^[^\p{L}]+/u,'').trim();
        abrirRoteiro(nome);
        return;
      }
      if(n.k==='lei' || n.k==='juris'){
        const termo=String(n.t).replace(/^[^\p{L}]+/u,'').trim();
        try{ window.parent.postMessage(
          {type:'ctAbrirAcervo', alvo:(n.k==='lei'?'legis':'juris'), termo}, '*'); }catch(_){}
        return;
      }
      if(!temF) return;
      if(fech) fechados.delete(n._id); else fechados.add(n._id);
      desenhar(); };
    mundo.appendChild(d);
    maxX=Math.max(maxX,n._x+240); maxY=Math.max(maxY,n._y+60);
  });
  fios.setAttribute('width',maxX); fios.setAttribute('height',maxY);
  fios.innerHTML='';
  arestas.forEach(([a,b])=>{
    const x1=a._x+LARG[a.k||'fase']/2-40, x2=b._x-LARG[b.k||'fase']/2+40;
    const p=document.createElementNS('http://www.w3.org/2000/svg','path');
    p.setAttribute('d',`M ${x1} ${a._y} C ${(x1+x2)/2} ${a._y}, ${(x1+x2)/2} ${b._y}, ${x2} ${b._y}`);
    p.setAttribute('fill','none'); p.setAttribute('stroke',COR[b.k||'fase']);
    p.setAttribute('stroke-width', b.k==='fase'||b.k==='assunto'?2.2:1.4);
    p.setAttribute('opacity', b.k==='fase'||b.k==='assunto'?.8:.42);
    fios.appendChild(p);
  });
}

/* ---------- zoom e arraste (roda, pinça e dois dedos) ---------- */
let esc=1, tx=0, ty=0;
const palco=document.getElementById('palco'), zl=document.getElementById('zl');
function aplicar(){ mundo.style.transform=`translate(${tx}px,${ty}px) scale(${esc})`;
  zl.textContent=Math.round(esc*100)+'%'; }
function zoomEm(fator, cx, cy){ zoomManual=true;
  const novo=Math.min(2.4, Math.max(0.25, esc*fator));
  tx = cx - (cx-tx)*(novo/esc); ty = cy - (cy-ty)*(novo/esc);
  esc=novo; aplicar();
}
palco.addEventListener('wheel', e=>{ e.preventDefault();
  zoomEm(e.deltaY<0?1.12:1/1.12, e.clientX, e.clientY); }, {passive:false});

const pts=new Map(); let distIni=0, escIni=1, arrast=null;
palco.addEventListener('pointerdown', e=>{ palco.setPointerCapture(e.pointerId);
  pts.set(e.pointerId,{x:e.clientX,y:e.clientY});
  if(pts.size===1){ arrast={x:e.clientX-tx, y:e.clientY-ty}; palco.classList.add('arrastando'); }
  if(pts.size===2){ const [a,b]=[...pts.values()];
    distIni=Math.hypot(a.x-b.x,a.y-b.y); escIni=esc; arrast=null; }
});
palco.addEventListener('pointermove', e=>{
  if(!pts.has(e.pointerId)) return;
  pts.set(e.pointerId,{x:e.clientX,y:e.clientY});
  if(pts.size===2){ const [a,b]=[...pts.values()];
    const d=Math.hypot(a.x-b.x,a.y-b.y);
    if(distIni>0){ const alvo=escIni*(d/distIni);
      const cx=(a.x+b.x)/2, cy=(a.y+b.y)/2; zoomEm(alvo/esc, cx, cy); }
    return; }
  if(arrast){ tx=e.clientX-arrast.x; ty=e.clientY-arrast.y; aplicar(); }
});
['pointerup','pointercancel'].forEach(ev=>palco.addEventListener(ev, e=>{
  pts.delete(e.pointerId); if(pts.size<2) distIni=0;
  if(pts.size===0){ arrast=null; palco.classList.remove('arrastando'); } }));

// Enquadrar NÃO significa "caber inteiro": uma disciplina com 39 tópicos caberia a 25%,
// ilegível. Prioriza a LARGURA (que é onde está a hierarquia) e nunca desce de 55% —
// o resto se alcança arrastando, que é o gesto natural num mapa.
// BUG que deixava o mapa minúsculo: a página carrega dentro de um iframe que ainda está
// ESCONDIDO (aba não selecionada), então palco.clientWidth é 0, dispW sai negativo e a
// escala cai no piso de 55% — e fica assim para sempre. Agora: se o palco não tem tamanho,
// não enquadra (espera); e um ResizeObserver reenquadra quando ele ganhar tamanho ou mudar,
// enquanto a pessoa não tiver mexido no zoom à mão.
let zoomManual=false;
function enquadrar(){
  const dispW=palco.clientWidth-40, dispH=palco.clientHeight-40;
  if(dispW<100 || dispH<100) return;
  let maxX=0, maxY=0; nos.forEach(n=>{ maxX=Math.max(maxX, n._x+240); maxY=Math.max(maxY, n._y+60); });
  esc=Math.min(1.1, Math.max(0.55, dispW/maxX));
  // centraliza na vertical quando sobra altura (árvore curta com as fases fechadas)
  tx=20; ty=Math.max(24, (palco.clientHeight-maxY*esc)/2); zoomManual=false; aplicar();
}
new ResizeObserver(()=>{ if(!zoomManual) enquadrar(); }).observe(palco);
document.getElementById('mais').onclick=()=>zoomEm(1.2, innerWidth/2, innerHeight/2);
document.getElementById('menos').onclick=()=>zoomEm(1/1.2, innerWidth/2, innerHeight/2);
document.getElementById('ajusta').onclick=enquadrar;
document.getElementById('tudo').onclick=()=>{ fechados.clear(); desenhar(); enquadrar(); };
// pílulas geradas do edital — 17 disciplinas, na ordem em que ele as traz
const mats=document.getElementById('mats');
Object.keys(MAPA).forEach((k,i)=>{
  const b=document.createElement('button');
  b.className='pill'+(i===0?' on':''); b.textContent=k;
  b.onclick=()=>{ mats.querySelectorAll('.pill').forEach(x=>x.classList.remove('on'));
    b.classList.add('on'); materia=k; if(abaAtual==='linha'){ seq=0; idear(MAPA[materia]); pintaLinha(); } else iniciar(); };
  mats.appendChild(b);
});

function iniciar(){
  seq=0; idear(MAPA[materia]); fechados.clear();
  // começa com as FASES fechadas: o mapa abre legível e a pessoa mergulha onde quiser
  desenhar();
  nos.filter(n=>n.k==='fase').forEach(n=>fechados.add(n._id));
  desenhar(); enquadrar();
  if(typeof abaAtual!=='undefined' && abaAtual==='linha') pintaLinha();
}
iniciar();
if(window.__abaInicial) window.__abaInicial();
</script>
