<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- O app do Mac (sem sandbox) divide com o widget o grupo do time: resumo.json e passe.json. app-groups é
       "validation-required", não "restricted": não derruba o processo nem a notarização. -->
