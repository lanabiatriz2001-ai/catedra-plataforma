{
  "name": "catedra-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Deploy da plataforma Cátedra na Vercel com IA (Claude) via função serverless.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "sentinela": "node scripts/sentinela.mjs",
    "sentinela:dry": "node scripts/sentinela.mjs --dry-run",
    "test": "node tests/run.mjs",
    "test:webkit": "node tests/run-webkit.mjs",
    "verificar:segredos": "node scripts/verificar-segredos.mjs",
    "test:compactacao-logica": "node --test tests/compactar-logica.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.27.0",
    "playwright-core": "^1.49.0"
  },
  "engines": {
    "node": ">=24"
  }
}
