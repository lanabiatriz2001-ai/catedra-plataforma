# build / deploy gerados
public/
node_modules/
# e o ARQUIVO com esse nome: um `git add -A` num worktree pegou o symlink node_modules
# (que apontava para si mesmo) e o versionou — isso quebra `npm install` em qualquer
# clone com "Too many levels of symbolic links". O padrão com barra só cobre diretório.
node_modules
.vercel

# segredos (a chave da API vive só nas variáveis de ambiente da Vercel)
.env
.env.local

# config local de preview/dev (contém caminhos absolutos desta máquina)
.claude/

# artefatos de trabalho (screenshots, versão antiga) — não fazem parte do app
scraps/
uploads/
# capturas de auditoria de interface (antes/depois): pesam MB e não são parte do produto
artifacts/

# macOS / sistema
.DS_Store
.thumbnail
.env*

# build do app nativo (binário compilado, gerado por mac/build-app.sh)
mac/build/
ios/build/
ios/Catedra.xcodeproj/xcuserdata/
ios/Catedra.xcodeproj/project.xcworkspace/xcuserdata/
# perfil de provisionamento: é credencial de assinatura, não vai para repo PÚBLICO
ios/embedded.mobileprovision
ios/build/perfil.plist
Catedra.dc.html.bak*

# Windows (Electron)
win/node_modules/
win/dist/
win/build/icon-256.png
win/app/

# cache de build do modulo de contas (14MB, regeravel)
scripts/.cache-contas/
ios/.build-n

# travas de build cruzado (mkdir atômico; morrem com o processo)
.build-lock-*

# lixo de manutenção do git de outra sessão (locks, worktree antiga) — entrou por engano
# num `git add -A` meu; fica no disco, fora do repositório
_to_delete/
