# Variáveis de ambiente das funções serverless (api/*.js). Configure na Vercel:
# Project → Settings → Environment Variables (Production + Preview). Para rodar local
# com `vercel dev`, copie para .env e preencha. NUNCA versione valores reais: a CI e o
# hook de pré-commit (scripts/verificar-segredos.mjs) abortam se acharem uma chave.

# --- IA (api/complete.js) — ordem de preferência: Anthropic direto > AI Gateway > Gemini
ANTHROPIC_API_KEY=            # sk-ant-… (console.anthropic.com); modelo padrão claude-sonnet-5
ANTHROPIC_MODEL=              # opcional — troca o modelo do Claude
AI_GATEWAY_API_KEY=           # vck_… (Vercel AI Gateway; exige cartão na conta Vercel)
AI_MODEL=                     # opcional — modelo do Gateway (padrão google/gemini-2.5-flash)
GEMINI_API_KEY=               # AIza… (Google AI Studio) — também é a ÚNICA fonte de voz (api/tts.js)
GEMINI_MODEL=                 # opcional
GEMINI_TTS_MODEL=             # opcional (api/tts.js)
GEMINI_TTS_VOICE=             # opcional (api/tts.js)

# --- Conta e cota (api/complete.js e api/tts.js consultam o Supabase com o token da pessoa)
SUPABASE_URL=                 # https://<projeto>.supabase.co (o projeto vivo é "catedraplataforma")
SUPABASE_PUBLISHABLE_KEY=     # chave publicável (anon) — pública por desenho; a secreta NUNCA entra aqui
BETA_EMAILS=                  # opcional — lista separada por vírgula; vazia = qualquer conta autenticada usa a IA
