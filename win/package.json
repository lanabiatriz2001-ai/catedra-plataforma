{
  "name": "catedra-desktop-win",
  "productName": "Cátedra",
  "version": "1.1.0",
  "description": "Cátedra · Plataforma de estudos — app desktop para Windows",
  "author": "Lana Biatriz",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.catedra.desktop",
    "productName": "Cátedra",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "app/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Catedra-Setup-${version}.${ext}",
      "shortcutName": "Cátedra",
      "uninstallDisplayName": "Cátedra · Plataforma de estudos"
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2"
  }
}
